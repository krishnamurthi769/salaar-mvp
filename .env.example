# SALAAR Environment Variables Template
# Copy this file to .env and fill in the values

# ==========================================
# Global Settings
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/salaar?schema=public"

# Redis connection for caching and queues (Bull/Celery)
REDIS_URL="redis://localhost:6379"

# Pinecone configuration
PINECONE_API_KEY="your_pinecone_api_key_here"
PINECONE_ENVIRONMENT="gcp-starter"
PINECONE_INDEX_NAME="salaar-memory"

# ==========================================
# Authentication & Security (Firebase)
# ==========================================
# Firebase Admin SDK credentials (can be path to JSON or base64 encoded string)
FIREBASE_PROJECT_ID="your_firebase_project_id"
FIREBASE_CLIENT_EMAIL="your_firebase_client_email"
FIREBASE_PRIVATE_KEY="your_firebase_private_key"

# JWT Secret for internal service-to-service communication
INTERNAL_JWT_SECRET="generate_a_strong_random_secret_here"

# ==========================================
# Payments (Razorpay)
# ==========================================
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ==========================================
# AI Models (Through Orchestrator ONLY)
# ==========================================
# OpenAI API Key (GPT models, DALL-E)
OPENAI_API_KEY="your_openai_api_key"

# Anthropic API Key (Claude models)
ANTHROPIC_API_KEY="your_anthropic_api_key"

# Search Engine API Key (Perplexity/Tavily/Serper for Research Agent)
SEARCH_API_KEY="your_search_api_key"

# Image Generation API Key (e.g., Midjourney API provider, Replicate, etc.)
IMAGE_GEN_API_KEY="your_image_gen_api_key"

# ==========================================
# Monitoring
# ==========================================
SENTRY_DSN="your_sentry_dsn"
PROMETHEUS_METRICS_PATH="/metrics"
